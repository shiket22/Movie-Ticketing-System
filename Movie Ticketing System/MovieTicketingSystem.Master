<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MovieTicketingSystem.master.cs" Inherits="Movie_Ticketing_System.MovieTicketingSystem" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
        rel="stylesheet" />

    <style type="text/css">
        body {
            font-family: 'Roboto', sans-serif; /* Use Roboto font for body text */
            font-size: 16px; /* Set body text font size */
            margin: 0;
            padding: 0;
        }

        /* CSS for Navbar */




        .navbar {
            background-color: black;
            overflow: hidden;
        }

            .navbar .others {
                display: block;
                color: white;
                text-align: center;
                padding: 14px 20px;
                text-decoration: none;
                float: left;
                font-family: 'Montserrat', sans-serif;
                font-size: 16px;
                font-weight: bold;
                position: relative;
                margin-top: 25px;
            }

                .navbar .others:hover {
                    color: #0fa4f7;
                }

                    .navbar .others:hover::after {
                        content: '';
                        position: absolute;
                        left: 0;
                        bottom: 0;
                        width: 100%;
                        height: 2px;
                        background-color: #0fa4f7;
                    }



            .navbar .right {
                float: right;
                margin-right: 10px;
            }

        .logo-link {
            float: left;
            text-decoration: none;
        }

            .logo-link img {
                margin-left: 10px;
                margin-right: 50px;
                height: 70px;
                width: 100px;
            }

        .search-container {
            float: right;
            margin-top: 25px;
        }

            .search-container input[type=text] {
                padding: 6px;
                margin-top: 8px;
                font-size: 17px;
                border: none;
                background-color: ghostwhite;
            }

            .search-container button {
                float: right;
                padding: 6px 10px;
                margin-top: 8px;
                margin-right: 16px;
                background-color: white;
                font-size: 17px;
                border: none;
                cursor: pointer;
            }

                .search-container button:hover {
                    background: #ccc;
                }

        .signup-login-button, .profile-button {
            margin-top: 26px;
            display: inline-block;
            padding: 10px 20px;
            background-color: #0fa4f7;
            color: white;
            text-decoration: none;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .signup-login-button:hover, .profile-button:hover{
                background-color: #0c7bbf;
            }

        /* Add clearfix to clear floats */

        .clearfix::after {
            content: "";
            clear: both;
            display: table;
        }

        /*                CSS for Footer  */

        .footer {
            background-color: black;
            color: white;
            padding: 20px 0;
            text-align: center;
            margin: 0;
            bottom: 0;
            width: 100%;
        }

            .footer table {
                margin: auto;
            }

            .footer td {
                padding: 10px;
            }



            .footer .social-icons img {
                width: 30px;
                height: 30px;
                margin: 0 5px;
            }

        .footer-links {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 10px;
            text-align: center;
            padding-right: 20px;
        }

            .footer-links a {
                color: #ccc;
                text-decoration: none;
            }

                .footer-links a:hover {
                    color: #0fa4f7;
                }

        .contact-info {
            font-size: 16px;
            width: 40%;
            color: #ccc;
        }

            .contact-info button {
                padding: 10px 20px;
                background-color: #0fa4f7;
                color: white;
                border: none;
                border-radius: 5px;
                cursor: pointer;
                transition: background-color 0.3s;
            }

                .contact-info button:hover {
                    background-color: #0c7bbf;
                }

        .footer hr {
            border-top: 1px solid #555;
        }

        .footer img {
            width: 30px;
            height: 30px;
            margin: 0 5px;
        }

        .sitemap {
            color: aliceblue;
            font-size: 15px;
            font-weight: 600;
            position: absolute;
            left: 0;
            right: 0;
            margin: auto;
            text-align: left;
            padding-top:10px;
        }
    </style>
</head>
<body>

    <div>
        <div class="navbar">
            <a href="Home.aspx" class="logo-link">
                <img alt="" src="Images\SSC Logo.png" /></a>
            <a class="others" href="MovieList.aspx">Movies</a>
            <a class="others" href="FnB.aspx">Food&Drinks</a>
            <a class="others" href="OrderCart.aspx">Cart</a>
            <a class="others" href="BookingHistory.aspx">Booking History</a>

            <div class="right">
                <a class="signup-login-button" href="LoginRegister.aspx">Sign Up / Log In</a>
                <a class="profile-button" href="UserProfile.aspx" id="profileButton">Profile</a>
            </div>
            <div class="search-container">
                <form action="searchResult.aspx" method="get">
                    <input type="text" placeholder="Search movies.." name="searchResult">
                    <button type="submit"><i class="ri-search-eye-line"></i></button>
                </form>
            </div>
        </div>
    </div>
    <div class="sitemap">
        <asp:SiteMapPath ID="SiteMapPath1" runat="server"></asp:SiteMapPath>
    </div>
    <div class="clearfix"></div>
    <!-- Add clearfix here -->
    <div class="content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            <p>
                &nbsp;
            </p>
        </asp:ContentPlaceHolder>
    </div>
    <div class="footer">
        <div>
            <table style="width: 100%;">
                <tr>
                    <td class="footer-links">
                        <a href="#">Movies</a><br />
                        <a href="#">Cinema</a><br />
                        <a href="#">Food</a><br />
                        <a href="#">Our Story</a><br />
                        <a href="#">FAQs</a>
                    </td>
                    <td class="contact-info">Cinema Name Adn.Bhd<br />
                        1234567890 (123-M)<br />
                        123 Example Street, Kuala Lumpur, Malaysia<br />
                    </td>
                    <td class="contact-info">How do I contact Customer Service?<br />
                        <button>Contact Us</button>
                    </td>
                </tr>
            </table>
        </div>
        <br />
        <hr />
        <div>
            <table style="width: 100%;">
                <tr>
                    <td>Download App<br />
                        <img src="Images\apple-logo.png" alt="Download App 1">
                        <img src="Images\android-logo.png" alt="Download App 2">
                        <img src="Images\huawei-logo.png" alt="Download App 3">
                    </td>
                    <td>Follow Us<br />
                        <a href="#">
                            <img src="Images\Facebook-logo.png" alt="Social Icon 1"></a>
                        <a href="#">
                            <img src="Images\Instagram-logo.png" alt="Social Icon 2"></a>
                        <a href="#">
                            <img src="Images\twitter-logo.png" alt="Social Icon 3"></a>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</body>
</html>
