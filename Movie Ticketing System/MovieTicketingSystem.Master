<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MovieTicketingSystem.master.cs" Inherits="Movie_Ticketing_System.MovieTicketingSystem" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SSC Cinema</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
        rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    <header class="site-header">
        <a href="Home.aspx" class="brand">
            <img alt="SSC Cinema" src="Images/SSC Logo.png" /></a>
        <nav class="site-nav">
            <a href="MovieList.aspx">Movies</a>
            <a href="FnB.aspx">Food &amp; Drinks</a>
            <a href="OrderCart.aspx">Cart</a>
            <a href="BookingHistory.aspx">Bookings</a>
        </nav>
        <form class="site-search" action="searchResult.aspx" method="get">
            <input type="text" placeholder="Search movies" name="searchResult" />
            <button type="submit" aria-label="Search"><i class="ri-search-line"></i></button>
        </form>
        <a class="account-link" id="accountLink" runat="server" href="~/LoginRegister.aspx">Log in</a>
    </header>
    <div class="crumbs">
        <asp:SiteMapPath ID="SiteMapPath1" runat="server"></asp:SiteMapPath>
    </div>
    <div class="content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>
    <footer class="site-footer">
        <div class="footer-inner">
            <p>SSC Cinema, a group project for BAIT2113 Web Application Development (2024). Not a real cinema.</p>
            <nav>
                <a href="MovieList.aspx">Movies</a>
                <a href="FnB.aspx">Food &amp; Drinks</a>
                <a href="BookingHistory.aspx">Bookings</a>
            </nav>
        </div>
    </footer>
</body>
</html>
