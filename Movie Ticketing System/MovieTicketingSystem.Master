<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MovieTicketingSystem.master.cs" Inherits="Movie_Ticketing_System.MovieTicketingSystem" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SSC Cinema</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
        rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    <header class="site-header">
        <a href="Home.aspx" class="brand">
            <img alt="SSC Cinema" src="Images/SSC Logo.png" /></a>
        <nav class="site-nav">
            <a href="MovieList.aspx">Movies</a>
            <a href="FnB.aspx">Food &amp; Drinks</a>
            <a href="OrderCart.aspx">Cart</a>
            <a href="BookingHistory.aspx">Bookings</a>
        </nav>
        <form class="site-search" action="searchResult.aspx" method="get">
            <input type="text" placeholder="Search movies" name="searchResult" />
            <button type="submit" aria-label="Search"><i class="ri-search-line"></i></button>
        </form>
        <a class="account-link" id="accountLink" runat="server" href="~/LoginRegister.aspx">Log in</a>
    </header>
    <div class="crumbs">
        <asp:SiteMapPath ID="SiteMapPath1" runat="server"></asp:SiteMapPath>
    </div>
    <div class="content">
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </div>
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-col">
                <img class="footer-logo" src="Images/SSC Logo.png" alt="SSC Cinema" />
                <p class="footer-address">
                    <i class="ri-map-pin-line"></i>
                    123 Example Street,<br />
                    Kuala Lumpur, Malaysia
                </p>
            </div>
            <div class="footer-col">
                <h3>Explore</h3>
                <nav class="footer-links">
                    <a href="MovieList.aspx">Movies</a>
                    <a href="MovieComingSoon.aspx">Coming soon</a>
                    <a href="FnB.aspx">Food &amp; Drinks</a>
                    <a href="BookingHistory.aspx">Bookings</a>
                </nav>
            </div>
            <div class="footer-col">
                <h3>Follow us</h3>
                <div class="social">
                    <a href="#" aria-label="Facebook"><i class="ri-facebook-fill"></i></a>
                    <a href="#" aria-label="Instagram"><i class="ri-instagram-line"></i></a>
                    <a href="#" aria-label="X"><i class="ri-twitter-x-line"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>Download the app</h3>
                <div class="app-badges">
                    <a href="#"><i class="ri-apple-fill"></i>App Store</a>
                    <a href="#"><i class="ri-google-play-fill"></i>Google Play</a>
                    <a href="#"><i class="ri-store-2-fill"></i>AppGallery</a>
                </div>
            </div>
        </div>
        <p class="footer-note">&copy; 2024 SSC Cinema. A group project for BAIT2113 Web Application Development, not a real cinema.</p>
    </footer>
    <script src="js/hold-timer.js"></script>
</body>
</html>
